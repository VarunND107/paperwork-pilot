# Copy to .env (start.bat / start.sh do this for you and generate random secrets).
# Never commit .env. Values starting with "change-me" are rejected in production.

# --- Postgres (used by docker compose) ---------------------------------------
# Use URL-safe characters only (letters and digits): the password is embedded in a URL.
POSTGRES_USER=paperwork
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=paperwork

# --- API ---------------------------------------------------------------------
# Used when you run the API outside Docker (npm run dev). Docker builds its own URL.
DATABASE_URL=postgresql://paperwork:change-me-postgres@localhost:5432/paperwork

# Signs admin sessions and reminder unsubscribe links. 16+ random characters.
SESSION_SECRET=change-me-session

# Admin panel login. Leave empty to disable the admin panel entirely.
ADMIN_PASSWORD=change-me-admin

# Public address of the web app. Used for links inside reminder emails.
PUBLIC_URL=http://localhost:8080

# Professional plan (organizations and client dashboard). Off by default.
PRO_ENABLED=false

# Reminders. "console" only logs the email. Real providers are a later step.
EMAIL_PROVIDER=console
REMINDERS_ENABLED=true
# node-cron expression, evaluated in Asia/Kolkata. Default: every day at 09:00.
REMINDER_CRON=0 9 * * *

# --- Ports -------------------------------------------------------------------
WEB_PORT=8080
API_PORT=4000
DB_PORT=5432
